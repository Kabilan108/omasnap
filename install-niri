#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
prefix="${OMASNAP_PREFIX:-$HOME/.local}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omasnap"
result_link="$state_dir/result"

required_commands=(niri nix)
for command_name in "${required_commands[@]}"; do
  if ! command -v "$command_name" >/dev/null; then
    printf 'install-niri: required command is unavailable: %s\n' "$command_name" >&2
    exit 1
  fi
done

mkdir -p \
  "$prefix/bin" \
  "$prefix/share/applications" \
  "$prefix/share/licenses/omasnap" \
  "$state_dir"

nix build "$repo_dir#omasnap" --out-link "$result_link"

ln -sfn "$result_link/bin/omasnap" "$prefix/bin/omasnap"
ln -sfn \
  "$result_link/share/applications/omasnap.desktop" \
  "$prefix/share/applications/omasnap.desktop"
ln -sfn \
  "$result_link/share/licenses/omasnap/Neucha-OFL.txt" \
  "$prefix/share/licenses/omasnap/Neucha-OFL.txt"

QT_QPA_PLATFORM=offscreen "$prefix/bin/omasnap" --version
